# Kopiraj ovu datoteku u .env.local za lokalni rad i upiši vrijednosti.
# Za produkciju iste varijable unesi u Netlify -> Site configuration -> Environment variables.
# NIKAD ne upisuj stvarne vrijednosti u ovu datoteku - ona je javna na GitHubu.

# Upstash Redis - baza koja pamti zahtjeve za termine
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Lozinka za admin stranicu (odobravanje/odbijanje termina)
ADMIN_PASSWORD=

# Formspree endpoint za e-mail obavijesti o novim zahtjevima za termin
FORMSPREE_BOOKING_ENDPOINT=