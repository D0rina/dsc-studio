# Kopiraj ovu datoteku u .env.local za lokalni rad, i unesi iste
# varijable u Vercel → Settings → Environment Variables za produkciju.

# Upstash Redis (besplatno) — baza koja pamti zahtjeve za termine
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Lozinka za /admin stranicu (odobravanje/odbijanje termina)
ADMIN_PASSWORD=
